    "python": ">=3.10"
  },
  "dependencies": {
    "python": ">=3.10",
    "packages": [
      {"name": "python-pptx", "version": ">=0.6.21"},
      {"name": "moviepy", "version": ">=1.0.3"},
      {"name": "openai", "version": ">=1.0.0"},
      {"name": "requests", "version": ">=2.28.0"},
      {"name": "PyYAML", "version": ">=6.0"}
    ]
  },
  "capabilities": [
    "file_read",
    "file_write",
    "network_request"
  ],
  "privacy": {
    "data_processing": "本地处理",
    "data_storage": "仅临时存储"
  }
