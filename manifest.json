{
  "name": "PPT转视频",
  "id": "com.trae.ppt2video",
  "version": "1.1.0",
  "description": "将PPT演示文稿自动转换为带语音讲解的视频",
  "author": {
    "name": "Trae AI",
    "email": "support@trae.cn"
  },
  "keywords": ["ppt", "video", "tts", "ai", "presentation"],
